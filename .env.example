# ServiceNow PDI
SERVICENOW_INSTANCE=dev00000.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=change_me
SERVICENOW_AUTH_MODE=basic
# Optional OAuth/bearer auth (set SERVICENOW_AUTH_MODE=oauth)
# Option A: static bearer token
SERVICENOW_BEARER_TOKEN=
# Option B: fetch token from OAuth client credentials + username/password grant
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_OAUTH_USERNAME=
SERVICENOW_OAUTH_PASSWORD=
# Optional overrides
SERVICENOW_OAUTH_SCOPE=
SERVICENOW_OAUTH_TOKEN_URL=

# Live data APIs
INCIDENTS_API_URL=http://127.0.0.1:8000/api/incidents
LOGS_API_URL=http://127.0.0.1:8000/api/logs
METRICS_API_URL=http://127.0.0.1:8000/api/metrics
RUNBOOKS_API_URL=http://127.0.0.1:8000/api/runbooks
HISTORICAL_INCIDENTS_API_URL=http://127.0.0.1:8000/api/historical-incidents
MANIFEST_API_URL=http://127.0.0.1:8000/api/manifest

# Shared auth for live data APIs
API_AUTH_TYPE=none
API_BEARER_TOKEN=
# API_BASIC_USERNAME=
# API_BASIC_PASSWORD=

DEFAULT_MODEL_NAME=azure-openai
RETRIEVAL_MODE=vector

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# API runtime
LOG_LEVEL=INFO
AUTH_TOKEN_TTL_SEC=28800
